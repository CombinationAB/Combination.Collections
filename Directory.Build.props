<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <Version>$(CMB_VERSION_PACKAGE_SEMVER)</Version>
    <InformationalVersion>$(CMB_VERSION)</InformationalVersion>
    <Product>$(CMB_PRODUCT)</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/Sports-Global/$(CMB_PROJECT)</RepositoryUrl>    
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Combination.CodeQuality.Rules" Version="1.6.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>

<configuration>
  <packageSources>
    <clear/>
    <add key="github" value="https://nuget.pkg.github.com/Sports-Global/index.json" />
    <add key="azdevops" value="https://pkgs.dev.azure.com/Derivco/_packaging/SportsBookLib/nuget/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="github" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
    <azdevops>
      <add key="Username" value="devops" />
      <add key="ClearTextPassword" value="%DERIVCO_DEVOPS_PAT%" />
    </azdevops>
  </packageSourceCredentials>
</configuration>
